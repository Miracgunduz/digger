# Bu dosyayı ".env" olarak kopyalayip gercek degerlerini gir.
# scanner.py bu degerleri os.getenv() ile okur, ".env" dosyasi asla git'e eklenmemeli.

# Reddit verisi su an anahtarsiz RSS ile cekiliyor (Data API onayi bekleniyor),
# bu yuzden sadece User-Agent yeterli. REDDIT_CLIENT_ID/SECRET, resmi API
# onaylandiginda PRAW'a gecince tekrar gerekecek.
REDDIT_USER_AGENT=firsat-avcisi-bot/1.0 by senin_reddit_kullanici_adin

# Google AI Studio'dan (aistudio.google.com/apikey) ucretsiz alinir, kredi karti gerekmez.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
